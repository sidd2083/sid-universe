rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email in ['sidd2083@gmail.com', 'sidhoni@gmail.com', 'sid@siduniverse.dev'] ||
        (request.auth.token.email != null && request.auth.token.email.matches('.*sidd2083.*')) ||
        request.auth.token.admin == true ||
        exists(/databases/$(database)/documents/admins/$(request.auth.token.email)) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // 1. Site Settings (General, Appearance, Background Music, Quotes)
    match /siteSettings/{settingId} {
      allow read: if true;
      allow write: if isAdmin() || isAuthenticated();
    }

    // 2. Public Activity (Real-time telemetry from Companion Daemon & Website)
    match /publicActivity/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // 3. Projects Showcase (StudentHub Nepal, GSConfession, etc.)
    match /projects/{projectId} {
      allow read: if true;
      allow write: if isAdmin() || isAuthenticated();
    }

    // 4. Learning & Exploring Topics
    match /learningTopics/{topicId} {
      allow read: if true;
      allow write: if isAdmin() || isAuthenticated();
    }

    // 5. Games & Gaming History
    match /games/{gameId} {
      allow read: if true;
      allow write: if isAdmin() || isAuthenticated();
    }

    // 6. Favorite Songs & Music Playlists
    match /songs/{songId} {
      allow read: if true;
      allow write: if isAdmin() || isAuthenticated();
    }

    match /playlists/{playlistId} {
      allow read: if true;
      allow write: if isAdmin() || isAuthenticated();
    }

    // 7. Watchlist & Reviews
    match /watchlist/{itemId} {
      allow read: if true;
      allow write: if isAdmin() || isAuthenticated();
    }

    // 8. Published Q&A
    match /publishedQA/{qaId} {
      allow read: if true;
      allow write: if isAdmin() || isAuthenticated();
    }

    // 9. Anonymous Messages (Public creation, Admin moderation)
    match /anonymousMessages/{msgId} {
      allow read: if isAdmin() || isAuthenticated();
      allow create: if request.resource.data.content is string || request.resource.data.message is string;
      allow update, delete: if isAdmin() || isAuthenticated();
    }

    // 10. Touches (Send a Touch to Sid from Website)
    match /touches/{touchId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin() || isAuthenticated();
    }

    // 11. Admin Whitelist Verification
    match /admins/{adminId} {
      allow read: if true;
      allow write: if false;
    }

    // Backward compatibility for any remaining legacy collections
    match /planets/{planetId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /timeline/{timelineId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
