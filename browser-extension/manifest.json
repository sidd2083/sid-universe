{
  "manifest_version": 3,
  "name": "Sid Universe Media Bridge",
  "version": "1.0.0",
  "description": "Bridges YouTube and YouTube Music playback to Sid Companion for SID UNIVERSE live telemetry.",
  "permissions": [
    "tabs"
  ],
  "host_permissions": [
    "https://*.youtube.com/*",
    "http://127.0.0.1:49152/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Sid Universe Media Bridge"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://music.youtube.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
