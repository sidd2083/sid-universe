{
  "manifest_version": 3,
  "name": "Sid Universe — Chrome Activity Bridge",
  "version": "2.0.0",
  "description": "Extracts active web, YouTube, and media activity in Google Chrome and streams it to Sid Companion.",
  "permissions": [
    "tabs",
    "activeTab",
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:49152/*",
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Sid Universe Chrome Bridge"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
